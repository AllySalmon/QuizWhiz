# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: full-access, bypasses RLS. Server-only — never expose to
# the browser (no NEXT_PUBLIC_ prefix). Used for private scan-images bucket access.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Project Settings -> Database -> Connect -> Direct/Transaction/Session pooler tabs) ---
# IMPORTANT: do NOT use the "Direct connection" tab's host (db.<ref>.supabase.co)
# — it's IPv6-only unless the project pays for the IPv4 add-on, and fails with
# ENOTFOUND on most networks/dev machines. Use the pooler tabs instead, which
# route through an IPv4-compatible host (aws-0-<region>.pooler.supabase.com)
# with username postgres.<project-ref> (note the dot).
#
# Transaction pooler tab (port 6543) — used by the app at runtime.
# lib/db/client.ts sets prepare:false, required for pgbouncer transaction mode.
DATABASE_URL=
# Session pooler tab (port 5432) — used only by drizzle-kit for migrations
# (drizzle.config.ts). Transaction-mode pooling doesn't reliably support the
# session/advisory-lock behavior migrations rely on, so this stays separate.
DIRECT_URL=

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Optional override — defaults to claude-sonnet-5 (lib/anthropic/client.ts).
# ANTHROPIC_GRADING_MODEL=

# --- Cron (production only — see README's "Scan image retention" section) ---
# Any random string of 16+ characters. Not used locally (nothing invokes
# app/api/cron/cleanup-scan-images locally) — only needs a real value on Vercel.
# CRON_SECRET=
